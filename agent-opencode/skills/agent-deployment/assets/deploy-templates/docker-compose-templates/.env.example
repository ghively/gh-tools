# .env — never commit. Copy to .env and fill in real values.

# === Provider keys ===
ZAI_API_KEY=REDACTED_ZAI_API_KEY
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === OpenAI-compatible base URL (for ZAI) ===
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# === Agent identity ===
AGENT_NAME=my-agent
AGENT_PORT=8000

# === Postgres (for stateful agents) ===
PGUSER=agent
PGPASSWORD=change-me
PGDB=agent

# === Hermes-specific (if using hermes-s6.yml) ===
HERMES_GATEWAY_TOKEN=change-me
HERMES_TELEGRAM_TOKEN=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === Observability ===
OTEL_ENDPOINT=
LANGSMITH_API_KEY=

# === Per-tenant keys (if using multi-tenant.yml) ===
TENANT_A_ZAI_KEY=
TENANT_B_ZAI_KEY=
TENANT_C_ZAI_KEY=

# === Ops ===
LOG_LEVEL=INFO
TZ=UTC
