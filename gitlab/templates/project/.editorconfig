# EditorConfig — https://editorconfig.org — keeps everyone's editor honest.
# Root = true stops upward directory search here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python: PEP 8.
[*.py]
indent_size = 4
max_line_length = 100

# Go, Rust, protobuf: tabs.
[*.{go,rs,proto}]
indent_style = tab

# Shell + makefiles: tabs (required for Makefile).
[*.{sh,bash,zsh}]
indent_style = tab

[Makefile]
indent_style = tab

# YAML / TOML / JSON / markdown / JS-family / Ruby / Helm: 2-space.
[*.{yml,yaml,toml,json,md,js,ts,jsx,tsx,rb,tpl}]
indent_size = 2

# Long-form docs: hard wrap ~100.
[*.md]
max_line_length = 100
